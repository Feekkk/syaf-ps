# Populated automatically by `netlify db init` / `netlify env:pull`.
NETLIFY_DATABASE_URL=

# Used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Only needed when running scripts/seed.mjs to create/update the admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
